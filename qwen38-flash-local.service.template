[Unit]
Description=Qwen3.8-Flash-Next FP4-Local (NVIDIA, vLLM b12x), OpenAI+Anthropic API :__PORT__
Wants=network-online.target
Requires=docker.service
# One engine at a time on this box, said to systemd: starting this lane stops the others
# and starting another stops this one, the stop finishing before the start in both
# directions (Conflicts= alone orders nothing, hence After= on the same units).
Conflicts=qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service
After=network-online.target docker.service qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
ExecStartPre=-/usr/bin/docker rm -f qwen38-flash-local
# The memory the last engine held has to be back before this one starts (see engine-preflight.sh).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-flash-local.service
# NVIDIA's serving command for a DGX Spark, from the model card at the pinned revision (the
# community b12x vLLM image, every environment variable and every flag as the card gives them:
# the NVFP4 experts and MXFP8 layers read by b12x, the n-gram embedding table read from the
# checkpoint's own files over io_uring with no table written beside it, the KV cache in FP8, a
# window of 262,144 tokens, MTP drafting 4 tokens, 8 requests at a time, a memory share of 0.8),
# with this box's port and key and the reasoning effort the card's chat template defaults to
# (xhigh), served under a name of its own, and one setting the card does not give, PyTorch's
# allocator (below). docs/flash-local-lane.md says what was measured.
# PYTORCH_CUDA_ALLOC_CONF: vLLM loads the weights with PyTorch's allocator splitting no block above
# 20 MiB, so the blocks b12x frees while it lays out the experts' NVFP4 scales are not used again,
# and the allocator's cache grows until the GPU's driver refuses it memory, then drops it at once.
# On this box the GPU's memory is the machine's: at each of twelve boots, four minutes in, the
# driver refused 44 to 149 allocations and MemAvailable fell to between 0.5 and 3.5 GiB. PyTorch
# collects its cached blocks only under a ceiling below the whole GPU: 0.95 of it, which nothing
# reaches, and the collection past 0.8 of that, about 92 GiB, above the 90 the engine holds in
# service. A boot with it kept 19 GiB free at its lowest (1.05 without it), met no refusal, and
# served with the same KV cache (measured on the reference box, 2026-10-20).
# --security-opt seccomp=seccomp-io-uring.json: the n-gram table is read over io_uring, whose
# three calls Docker's default seccomp profile refuses. The card turns seccomp and AppArmor off
# for it; this lane keeps both, with Docker's own default profile (Docker 29.6.2's, unchanged)
# plus those three calls and nothing else (a test holds the file to that): the engine runs as
# root in its container on the host's network, and with the filter off it could, for one, make a
# user namespace, which Docker's profile refuses (measured on the reference box, 2026-10-19).
# Its own caches, so that a boot after the first builds nothing again: vLLM's compile cache and
# its AOT artifacts, FlashInfer's and Triton's kernels, and b12x's kernel choices, tuned on this
# GPU at the first boot (a first boot took 17 min, a later one 5 min 37 on the reference box).
# The n-gram table is read at every token from seven of the checkpoint's files: with the cache on
# another disk than the home directory's, copies of those seven are mounted over the cache's own,
# file by file (ple-table.py says why); with the cache there, the line names nothing.
# PYTHONDONTWRITEBYTECODE and HF_MODULES_CACHE: nothing root-owned lands in the user's HF cache.
# The sampling defaults (temperature 1.0, top_k 20, top_p 0.95) are the checkpoint's
# generation_config.json, which vLLM applies to any request that does not set them.
# VLLM_NO_USAGE_STATS and DO_NOT_TRACK: vLLM reports anonymous usage to its authors by default; a
# box that serves its owner's data sends nothing anywhere.
# Of the config directory, the two files the engine reads, read-only, and nothing else: its key and
# its chat template. The image is a community build, from one account, and the directory holds the
# cockpit's own secret and the other services' keys, which a read-only mount still shows (found in
# review, 2026-10-20). --mount, not -v: a source that is not there fails the start, where -v made a
# directory in its place, owned by root.
# vllm_engine_auth.RequireKey asks the key on every route but /health and /metrics, as on the
# other lanes. No --api-key and no --config: this build would put /metrics behind the key, which
# the cockpit and the proxy read without one, and the middleware already asks it everywhere else.
# No dev mode: its /server_info carries no pool, and the proxy reads the pool from /metrics only
# where /server_info is absent (the vLLM lanes' way).
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-flash-local --gpus all \
  --memory 110g --memory-swap 110g --shm-size 16g --network host --ipc=host \
  --ulimit memlock=-1 --ulimit stack=67108864 \
  --security-opt seccomp=__HOME__/.config/qwen38/seccomp-io-uring.json \
  -e HF_HUB_OFFLINE=1 -e VLLM_NO_USAGE_STATS=1 -e DO_NOT_TRACK=1 \
  -e PYTHONDONTWRITEBYTECODE=1 -e HF_MODULES_CACHE=/tmp/hf-modules \
  -e PYTHONPATH=/opt/qwen38-auth -e QWEN38_KEY_FILE=/out/api-key \
  -e VLLM_PLE_TABLE_MEMORY=disk -e B12X_DISK_BACKEND=io_uring \
  -e CUTE_DSL_ARCH=sm_121a -e SAFETENSORS_FAST_GPU=1 \
  -e VLLM_WORKER_MULTIPROC_METHOD=spawn -e VLLM_SSM_CONV_STATE_LAYOUT=DS \
  -e VLLM_USE_AOT_COMPILE=1 -e VLLM_USE_MEGA_AOT_ARTIFACT=1 \
  -e VLLM_USE_V2_MODEL_RUNNER=1 -e B12X_POLICY_MODE=auto \
  -e VLLM_MXFP8_LM_HEAD=1 -e VLLM_B12X_MOE_FP4_LAYER_MAX_INPUT_SCALE=w13 \
  -e VLLM_B12X_MOE_FP4_FORCE_A16=1 -e B12X_W4A16_A4_PREFILL=1 \
  -e PYTORCH_CUDA_ALLOC_CONF=per_process_memory_fraction:0.95,garbage_collection_threshold:0.8 \
  -v __HOME__/.config/qwen38/flash-local-cache/vllm:/root/.cache/vllm \
  -v __HOME__/.config/qwen38/flash-local-cache/flashinfer:/root/.cache/flashinfer \
  -v __HOME__/.config/qwen38/flash-local-cache/b12x:/root/.cache/b12x \
  -v __HOME__/.config/qwen38/flash-local-cache/triton:/root/.triton \
  -v __HF_CACHE__:/root/.cache/huggingface \
  __TABLE_MOUNTS__ \
  --mount type=bind,source=__HOME__/.config/qwen38/api-key,target=/out/api-key,readonly \
  --mount type=bind,source=__HOME__/.config/qwen38/chat-template-flash-local.jinja,target=/out/chat-template-flash-local.jinja,readonly \
  -v __HOME__/.config/qwen38/vllm-auth:/opt/qwen38-auth:ro \
  __IMAGE__ \
  vllm serve __MODEL__ --revision __REV__ \
    --served-model-name qwen3.8-flash-next-fp4 \
    --quantization modelopt_mixed --load-format b12x \
    --dtype bfloat16 --kv-cache-dtype fp8 --block-size 16 \
    --mamba-cache-mode align --enable-prefix-caching --enable-chunked-prefill \
    --max-model-len 262144 --max-num-seqs __SEQS__ --max-num-batched-tokens 4096 \
    --gpu-memory-utilization __GMU__ \
    --speculative-config.method mtp --speculative-config.num_speculative_tokens 4 \
    --gdn-decode-kernel b12x --linear-backend b12x --moe-backend b12x \
    --no-enable-flashinfer-autotune --mm-encoder-tp-mode data \
    --compilation-config.pass_config.fuse_act_quant true \
    --reasoning-parser qwen3 --tool-call-parser qwen3_xml --enable-auto-tool-choice \
    --chat-template /out/chat-template-flash-local.jinja \
    --allowed-media-domains media.invalid \
    --middleware vllm_engine_auth.RequireKey \
    --host __ENGINE_BIND__ --port __PORT__'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-flash-local
Restart=always
# docker stops vLLM with SIGTERM (143) or SIGKILL (137) on a plain stop: a clean stop, not a failure
SuccessExitStatus=137 143
RestartSec=15

[Install]
WantedBy=multi-user.target
