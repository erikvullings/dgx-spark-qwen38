[Unit]
Description=Qwen3.8-27B NVFP4 + DFlash2 (SGLang, capped docker), OpenAI+Anthropic API :__PORT__
Wants=network-online.target
Requires=docker.service
# One engine at a time on this box, said to systemd: starting this lane stops the others
# and starting another stops this one, the stop finishing before the start in both
# directions (Conflicts= alone orders nothing; measured with throwaway units on the
# reference box's systemd 255, 2026-09-24). Until v1.18.7 only the image lane said so,
# and two text lanes could run side by side, or both start at boot if both were enabled.
Conflicts=qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-nanbeige.service qwen38-groot.service
After=network-online.target docker.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-nanbeige.service qwen38-groot.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
ExecStartPre=-/usr/bin/docker rm -f qwen38-sglang
# The memory the last engine held has to be back before this one starts: a start piled on
# memory the driver kept is how sglang#40948 froze a DGX Spark (see engine-preflight.sh).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-sglang.service
# The key goes to the server in a file SGLang merges in memory (see engine-secrets.sh),
# written again before every start, so it is on no command line.
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-secrets.sh
# SGLANG_ENABLE_HEALTH_ENDPOINT_GENERATION=0: GET /health answers from the server's state, 503
# while it starts and 200 once it serves, instead of generating a token whenever the engine is
# idle. /health takes no key, and the proxy relayed it from the network (D02 of the 2026-10-24
# security review); /health_generate still generates, and the proxy asks the key for it.
# SGLANG_DISTRIBUTED_INIT_METHOD_OVERRIDE: the rendezvous of the engine's one process goes through a file
# in the container, which --rm makes new at each start. torch's TCPStore, the default, listened on every
# interface whatever address it was given (*:23906 on the reference box, 2026-10-30, no key, no firewall),
# and with the file no port opens for it. GLOO_SOCKET_IFNAME and NCCL_SOCKET_IFNAME keep gloo's and NCCL's
# bootstrap on lo: under the real clients, the lane listened on four ports of the box's LAN address without
# them, though the box's name resolves to 127.0.0.1 (2026-10-30).
# --enable-cache-report: each answer says how much of its prompt the prefix cache served
# (usage.prompt_tokens_details.cached_tokens, and cache_read_input_tokens beside input_tokens on
# /v1/messages), which the engine counts anyway. Asked in discussion #49, measured on this lane
# on 2026-10-24: every client did its task, and the throughput did not move.
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-sglang --gpus all \
  --memory 100g --memory-swap 100g --shm-size 16g --network host --ipc=host \
  -e TORCHINDUCTOR_CACHE_DIR=/cache/inductor \
  -e SGLANG_ENABLE_REQUEST_HEADER_OVERRIDES=1 \
  -e SGLANG_ENABLE_HEALTH_ENDPOINT_GENERATION=0 \
  -e SGLANG_DISTRIBUTED_INIT_METHOD_OVERRIDE=file:///tmp/sglang-rdv \
  -e GLOO_SOCKET_IFNAME=lo -e NCCL_SOCKET_IFNAME=lo \
  -e HF_HUB_OFFLINE=1 \
  -v __HOME__/.config/qwen38/sglang-cache:/cache \
  -v __HF_CACHE__:/root/.cache/huggingface \
  -v __HOME__/.config/qwen38:/out:ro \
  __IMAGE__ \
  python3 -m sglang.launch_server \
    --model-path __MODEL__ __MODEL_REV_ARGS__ --tp-size 1 \
    --served-model-name qwen3.8-27b \
    --mem-fraction-static 0.50 __KV_CACHE_ARGS__\
    --attention-backend flashinfer --chunked-prefill-size 8192 \
    --disable-prefill-cuda-graph --cuda-graph-max-bs-decode 8 \
    --disable-flashinfer-autotune \
    --speculative-algorithm DFLASH --speculative-draft-model-path __DRAFT2_REPO__ \
    --speculative-draft-model-revision __DRAFT2_REV__ \
    --speculative-num-draft-tokens __DRAFT2_TOKENS__ --speculative-draft-model-quantization __DRAFT2_QUANT__ \
    --mamba-radix-cache-strategy extra_buffer --mamba-ssm-dtype bfloat16 \
    --max-mamba-cache-size 96 --max-running-requests 8 \
    --enable-torch-compile --torch-compile-max-bs 4 \
    --num-continuous-decode-steps 2 --sleep-on-idle \
    --enable-metrics --enable-cache-report \
    --reasoning-parser qwen3 --tool-call-parser qwen3_coder \
    --chat-template /out/chat-template-sglang.jinja \
    --config /out/engine-secrets.yaml \
    --host __ENGINE_BIND__ --port __PORT__'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-sglang
Restart=always
# docker kills SGLang with SIGKILL (137) or SIGTERM (143) on a plain stop; that is
# a clean stop, not a failure (v1.5.5: the cockpit showed 'failed' after every stop)
SuccessExitStatus=137 143
RestartSec=15

[Install]
WantedBy=multi-user.target
