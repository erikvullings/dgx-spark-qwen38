[Unit]
Description=Qwen3.8-27B NVFP4 + DFlash2, sized for a 64 GB DGX Spark (SGLang, capped docker), OpenAI+Anthropic API :__PORT__
Wants=network-online.target
Requires=docker.service
# One engine at a time on this box, said to systemd: starting this lane stops the others
# and starting another stops this one, the stop finishing before the start in both
# directions (Conflicts= alone orders nothing; measured with throwaway units on the
# reference box's systemd 255, 2026-09-24). Until v1.18.7 only the image lane said so,
# and two text lanes could run side by side, or both start at boot if both were enabled.
Conflicts=qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service
After=network-online.target docker.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service

[Service]
# The memory settings of a 64 GB DGX Spark, measured on a 64 GB budget (2026-10-24: on the reference
# box at the fraction that gives SGLang the same absolute budget, as it sizes the pool from the memory
# free before its weights load). 0.65 is the highest fraction that left 6 GiB at the peak under four
# requests filling the pool (6.2 GiB; 0.70 left 3.7). The Mamba cache, which SGLang sizes per
# running request, holds 12 slots: 4.4 GiB of the budget where 24 took 7.5, and SGLang runs two
# requests at a time with them (six slots each), whatever --max-running-requests says. The pool came
# to 59,625 tokens on that boot, and moves from one boot to the next with the page cache reading the
# weights fills. A 64 GB box serves Nemotron 3.5 Bolt; this lane is a Load away (install.sh).
Type=simple
User=__USER__
Group=__GROUP__
ExecStartPre=-/usr/bin/docker rm -f qwen38-sglang
# The memory the last engine held has to be back before this one starts: a start piled on
# memory the driver kept is how sglang#40948 froze a DGX Spark (see engine-preflight.sh).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-sglang.service
# The key goes to the server in a file SGLang merges in memory (see engine-secrets.sh),
# written again before every start, so it is on no command line.
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-secrets.sh
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-sglang --gpus all \
  --memory 32g --memory-swap 32g --shm-size 8g --network host --ipc=host \
  -e TORCHINDUCTOR_CACHE_DIR=/cache/inductor \
  -e SGLANG_ENABLE_REQUEST_HEADER_OVERRIDES=1 \
  -e HF_HUB_OFFLINE=1 \
  -v __HOME__/.config/qwen38/sglang-cache:/cache \
  -v __HF_CACHE__:/root/.cache/huggingface \
  -v __HOME__/.config/qwen38:/out:ro \
  __IMAGE__ \
  python3 -m sglang.launch_server \
    --model-path __MODEL__ __MODEL_REV_ARGS__ --tp-size 1 \
    --served-model-name qwen3.8-27b \
    --mem-fraction-static 0.65 __KV_CACHE_ARGS__\
    --attention-backend flashinfer --chunked-prefill-size 8192 \
    --disable-prefill-cuda-graph --cuda-graph-max-bs-decode 4 \
    --disable-flashinfer-autotune \
    --speculative-algorithm DFLASH --speculative-draft-model-path __DRAFT2_REPO__ \
    --speculative-draft-model-revision __DRAFT2_REV__ \
    --speculative-num-draft-tokens __DRAFT2_TOKENS__ --speculative-draft-model-quantization __DRAFT2_QUANT__ \
    --mamba-radix-cache-strategy extra_buffer --mamba-ssm-dtype bfloat16 \
    --max-mamba-cache-size 12 --max-running-requests 4 \
    --enable-torch-compile --torch-compile-max-bs 4 \
    --num-continuous-decode-steps 2 --sleep-on-idle \
    --enable-metrics \
    --reasoning-parser qwen3 --tool-call-parser qwen3_coder \
    --chat-template /out/chat-template-sglang.jinja \
    --config /out/engine-secrets.yaml \
    --host __ENGINE_BIND__ --port __PORT__'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-sglang
Restart=always
# docker kills SGLang with SIGKILL (137) or SIGTERM (143) on a plain stop; that is
# a clean stop, not a failure (v1.5.5: the cockpit showed 'failed' after every stop)
SuccessExitStatus=137 143
RestartSec=15

[Install]
WantedBy=multi-user.target
