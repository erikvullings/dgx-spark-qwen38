[Unit]
Description=Ling 3.0 Flash MXFP4 Humming (experimental SGLang)
Wants=network-online.target
Requires=docker.service
Conflicts=qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-nanbeige.service
After=network-online.target docker.service qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-nanbeige.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
TimeoutStartSec=1800
ExecStartPre=-/usr/bin/docker rm -f qwen38-ling qwen38-ling-compile
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-ling.service
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-secrets.sh
ExecStartPre=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-ling-compile --gpus all --network host --ipc=host --memory 100g --memory-swap 100g --shm-size 16g \
  -e LING_BIND=__ENGINE_BIND__ -e LING_PORT=__PORT__ -e HF_HUB_OFFLINE=1 \
  -v __HF_CACHE__:/root/.cache/huggingface \
  -v __HOME__/.config/qwen38/ling-cache/flashinfer:/root/.cache/flashinfer \
  -v __HOME__/.config/qwen38/ling-cache/humming:/root/.humming/cache \
  -v __HOME__/.config/qwen38/ling-cache/triton:/root/.triton \
  --mount type=bind,source=__HOME__/.config/qwen38/engine-secrets.yaml,target=/out/engine-secrets.yaml,readonly \
  __IMAGE__ /opt/ling/ling-precompile.py'
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-ling --gpus all --network host --ipc=host --memory 100g --memory-swap 100g --shm-size 16g \
  -e LING_BIND=__ENGINE_BIND__ -e LING_PORT=__PORT__ -e HF_HUB_OFFLINE=1 \
  -v __HF_CACHE__:/root/.cache/huggingface \
  -v __HOME__/.config/qwen38/ling-cache/flashinfer:/root/.cache/flashinfer \
  -v __HOME__/.config/qwen38/ling-cache/humming:/root/.humming/cache \
  -v __HOME__/.config/qwen38/ling-cache/triton:/root/.triton \
  --mount type=bind,source=__HOME__/.config/qwen38/engine-secrets.yaml,target=/out/engine-secrets.yaml,readonly \
  __IMAGE__ /opt/ling/ling-launch.py --model-path __MODEL__ --revision __REV__'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-ling qwen38-ling-compile
ExecStopPost=-/usr/bin/docker rm -f qwen38-ling qwen38-ling-compile
Restart=on-failure
RestartSec=15
SuccessExitStatus=137 143

[Install]
WantedBy=multi-user.target
