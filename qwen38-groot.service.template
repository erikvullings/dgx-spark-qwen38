[Unit]
Description=Groot-65B-A6B mixed NVFP4/FP8 (experimental, vLLM), API :__PORT__
Wants=network-online.target
Requires=docker.service
Conflicts=qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-nanbeige.service
After=network-online.target docker.service qwen38-sglang.service qwen38-flash.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-nanbeige.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
ExecStartPre=-/usr/bin/docker rm -f qwen38-groot
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-groot.service
# Mixed NVFP4/FP8 weights. 128K context and one request are initial limits, not measured ceilings.
# Standard compressed-tensors loader; no inherited hybrid/MTP/YaRN or NVFP4 flags.
ExecStart=/bin/bash -c 'exec /usr/bin/docker run --rm --name qwen38-groot --gpus all \
  --memory 116g --memory-swap 116g --shm-size 16g --network host --ipc=host \
  -e HF_HUB_OFFLINE=1 -e VLLM_NO_USAGE_STATS=1 -e DO_NOT_TRACK=1 \
  -e PYTHONDONTWRITEBYTECODE=1 -e HF_MODULES_CACHE=/tmp/hf-modules \
  -e PYTHONPATH=/opt/qwen38-auth -e QWEN38_KEY_FILE=/out/api-key \
  -v __HOME__/.config/qwen38/groot-cache/vllm:/root/.cache/vllm \
  -v __HF_CACHE__:/root/.cache/huggingface \
  --mount type=bind,source=__HOME__/.config/qwen38/api-key,target=/out/api-key,readonly \
  --mount type=bind,source=__HOME__/.config/qwen38/chat-template-groot.jinja,target=/out/chat-template-groot.jinja,readonly \
  -v __HOME__/.config/qwen38/vllm-auth:/opt/qwen38-auth:ro \
  __IMAGE__ \
  vllm serve __MODEL__ --revision __REV__ \
    --served-model-name groot-65b-a6b \
    --chat-template /out/chat-template-groot.jinja \
    --dtype bfloat16 --kv-cache-dtype auto \
    --mamba-cache-mode align \
    --enable-prefix-caching --enable-chunked-prefill \
    --max-model-len 131072 --max-num-seqs __SEQS__ --max-num-batched-tokens 4096 \
    --gpu-memory-utilization __GMU__ \
    --reasoning-parser qwen3 --tool-call-parser qwen3_coder --enable-auto-tool-choice \
    --middleware vllm_engine_auth.RequireKey \
    --host __ENGINE_BIND__ --port __PORT__'
ExecStop=-/usr/bin/docker stop -t 20 qwen38-groot
Restart=on-failure
SuccessExitStatus=137 143
RestartSec=15

[Install]
WantedBy=multi-user.target
