[Unit]
Description=Qwen-Image 2.1 (SGLang Diffusion, native venv), OpenAI images API :__IMAGE_PORT__
Wants=network-online.target
# One engine at a time on this box, and systemd is where that is said rather than in a
# wrapper someone can bypass: the image checkpoint is 31 GB of weights and peaks at
# 34.8 GiB during a 1024px request (measured), while the LLM lane holds its pool for the
# life of the process. Starting this stops the LLM lane; starting an LLM lane stops this.
Conflicts=qwen38-sglang.service qwen38-flash.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service
# Conflicts= alone orders nothing: the old lane's stop and the new lane's start ran side
# by side (5 to 60 s on the reference box, 2026-09-23). With the same units named in
# After=, systemd finishes the stop before the start, in both directions (measured on
# its systemd 255: 3.0 s of overlap without, 0.02 s after the stop with, 2026-09-24).
After=network-online.target qwen38-sglang.service qwen38-flash.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__IMAGE_LANE_DIR__
Environment=HF_HOME=__HF_CACHE__
Environment=HF_HUB_OFFLINE=1
Environment=PYTHONUNBUFFERED=1
# The venv's bin first, as an activated venv has it, before the directories a unit gets otherwise
# (snapd's generator adds /snap/bin to them): SGLang Diffusion compiles kernels at their first use
# (sglang/kernels/jit) and runs ninja by name, which the venv has (flashinfer, modelopt and sglang
# require it) and a new box does not: the first image on an ASUS Ascent GX10 with DGX OS 7.6.0
# failed on "No such file or directory: 'ninja'" (2026-10-21).
Environment=PATH=__IMAGE_VENV__/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
# The memory the last engine held has to be back before this one starts: a start piled on
# memory the driver kept is how sglang#40948 froze a DGX Spark (see engine-preflight.sh).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-image.service
# This lane has no key and takes paths from whoever reaches it (dump and output paths),
# with this user's rights; ~/.config/qwen38 holds the serving key and the engine-preflight.sh
# every lane runs before it starts, and the lane writes nothing there (2026-10-16: found in
# review, a lane bound past loopback could overwrite either). engine-preflight.sh writes
# nothing either.
# It sees that directory as an empty read-only tmpfs with the preflight bound into it, and
# nothing else of it (2026-10-17): the serving key is also in the engine-secrets.yaml the text
# lanes write there at every start, and a mask laid on each file when the lane starts misses a
# file made later and is detached by a rename over it on the host, which is how
# engine-secrets.sh writes the key (found in review, measured with a mount namespace). The
# preflight needs nothing else there.
TemporaryFileSystem=__HOME__/.config/qwen38:ro
BindReadOnlyPaths=-__HOME__/.config/qwen38/engine-preflight.sh
# Nor the identity wall's client keys, which docs/clients.md installs in /etc/qwen38 readable by
# this user (2026-10-17). "-": most boxes have no such directory; one made while the lane runs
# shows to it until its next start.
InaccessiblePaths=-/etc/qwen38
# The runtime's own sockets (install-image.sh, IMAGE_IP_DENY): the bootstrap of its process group on lo
# and, with a loopback bind, no traffic but loopback's: no fetch of an image by its URL either.
Environment=GLOO_SOCKET_IFNAME=lo
Environment=NCCL_SOCKET_IFNAME=lo
IPAddressAllow=__IMAGE_IP_ALLOW__
IPAddressDeny=__IMAGE_IP_DENY__
# The cookbook's DGX Spark recipe, and nothing else: one GPU, every component resident,
# the runtime picking its own attention (it logs "Defaulting to Torch SDPA backend on
# SM12.x"), full-image VAE decode, eager execution, batch 1. Forcing any of those is how
# a verified recipe stops being the verified recipe.
# NO --api-key, and that is not an omission. The diffusion runtime is a different parser
# from the LLM one: it has no --api-key and no --sleep-on-idle, and passing either kills
# the unit at startup with "unrecognized arguments" (measured 2026-09-22; `sglang serve
# --help` lists them because without a resolvable diffusion model it prints the LLM
# parser). So this lane cannot authenticate anyone, and the loopback bind below is the
# only thing standing in front of it. The cockpit is the authenticated door.
#
# --output-path "" and --input-save-path "": by default this server writes every image it
# makes AND every reference anyone uploads under its working directory, forever
# (measured: 103 MB in one afternoon of testing). Both are read back as None when empty,
# and the cockpit and the API take their pixels from the response, so nothing needs the
# copy. Give them a directory instead if you want an archive, and watch it grow.
ExecStart=__IMAGE_VENV__/bin/sglang serve \
  --model-path __IMAGE_MODEL__ \
  --performance-mode speed \
  --output-path "" \
  --input-save-path "" \
  --host __IMAGE_BIND__ --port __IMAGE_PORT__
Restart=on-failure
RestartSec=15
# No TimeoutStartSec: systemd counts a Type=simple unit started once its process runs,
# so the setting never bounded the ~77 s it takes to load 31 GB of weights (found in
# review, 2026-09-24). install-image.sh and the cockpit wait on /health for that.
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
