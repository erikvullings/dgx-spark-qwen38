[Unit]
Description=Qwen3.8-Flash-Next NVFP4 + NEXTN (SGLang, PLE table on NVMe, capped docker), OpenAI API :__PORT__
Wants=network-online.target
Requires=docker.service
# One engine at a time on this box, said to systemd: starting this lane stops the others
# and starting another stops this one, the stop finishing before the start in both
# directions (Conflicts= alone orders nothing; measured with throwaway units on the
# reference box's systemd 255, 2026-09-24). Until v1.18.7 only the image lane said so,
# and two text lanes could run side by side, or both start at boot if both were enabled.
Conflicts=qwen38-sglang.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-nanbeige.service
After=network-online.target docker.service qwen38-sglang.service qwen38-image.service qwen38-video.service qwen38-kolibri.service qwen38-nemotron.service qwen38-nemotron-super.service qwen38-flash-local.service qwen38-ornith-122b.service qwen38-nanbeige.service

[Service]
Type=simple
User=__USER__
Group=__GROUP__
ExecStartPre=-/usr/bin/docker rm -f qwen38-flash
# The memory the last engine held has to be back before this one starts: a start piled on
# memory the driver kept is how sglang#40948 froze a DGX Spark (see engine-preflight.sh).
ExecStartPre=/bin/bash __HOME__/.config/qwen38/engine-preflight.sh qwen38-flash.service
ExecStart=/bin/bash __HOME__/.config/qwen38/launch-flash.sh
ExecStop=-/usr/bin/docker stop -t 20 qwen38-flash
Restart=always
# 78: the launcher found a GPU outside its ATS addressing mode, which no new start changes
# (flash-ats-check.sh, issue #54); the unit stays failed with the reason in its journal
RestartPreventExitStatus=78
# docker kills SGLang with SIGKILL (137) or SIGTERM (143) on a plain stop; that is
# a clean stop, not a failure (v1.5.5: the cockpit showed 'failed' after every stop)
SuccessExitStatus=137 143
RestartSec=15

[Install]
WantedBy=multi-user.target
